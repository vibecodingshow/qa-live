{
  "name": "vibe-coding-show",
  "version": "1.0.0",
  "description": "Full-stack application with React frontend and Node.js backend",
  "main": "index.js",
  "scripts": {
    "install-all": "npm run install:server && npm run install:web && npm install",
    "install:server": "cd server && npm install",
    "install:web": "cd web && npm install",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "cd server && npm run dev",
    "dev:web": "cd web && npm run dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "cd server && npm run build",
    "build:web": "cd web && npm run build",
    "start": "concurrently \"npm run start:server\" \"npm run start:web\"",
    "start:server": "cd server && npm start",
    "start:web": "cd web && npm start",
    "test": "npm run test:server && npm run test:web",
    "test:server": "cd server && npm test",
    "test:web": "cd web && npm test"
  },
  "keywords": [
    "react",
    "node",
    "fullstack"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}